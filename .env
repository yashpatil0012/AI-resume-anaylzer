# AI Resume Analyzer - Backend Environment Variables
# Copy this file to .env and insert your API key:
#   copy .env.example .env

# Option 1: Google Gemini (Recommended - Free Tier available)
GEMINI_API_KEY= 

# Option 2: OpenAI
# OPENAI_API_KEY=your_openai_api_key_here

# Option 3: Groq (Fast & Free Tier available)
# GROQ_API_KEY=your_groq_api_key_here

# Optional: Override OpenAI model or base URL (e.g., for OpenRouter, Ollama, DeepSeek)
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gemini-2.5-flash
